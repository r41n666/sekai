# Godot 4+ specific ignores
.godot/
/android/

# 验收截图工具的临时输出目录（挑好的图再手动放进 docs/acceptance/）
/_accept_tmp/

# tools/verify.sh 的排查日志目录（失败时保留、成功时自动清理）
/.verify_tmp/

# tools/mutation_es42.py 的变异体备份目录（源码原件备份，用于还原注入）
/.tmpdbg/

# tools/mutation_combat_anim.py 的字节备份目录（跨运行稳定，用于启动自愈还原）
/.mutation_backup/

# tools/mutation_weapon_hold.py 的字节备份目录（与上者分开，PENDING.json 不能互相覆盖）
/.mutation_backup_holdik/

# tools/capture_hold_ik.gd 的临时截图输出（目视验证用，挑好的图再归档）
/tmp_spike/
